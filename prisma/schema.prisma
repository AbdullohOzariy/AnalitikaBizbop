// Analitika BizBop — supermarket savdo analitika platformasi
// Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN // to'liq huquq — barcha tahrir + Tizim bo'limi (oldingi ADMIN)
  ADMIN // read-only — Tizimdan boshqa hammasini ko'radi, o'zgartira olmaydi
  VIEWER // eskirgan — ishlatilmaydi (migratsiyada CAT_MANAGER'ga o'tkazilgan). UI'da yo'q.
  CAT_MANAGER
  CEO
  SUPPLYCHAIN // ta'minot zanjiri: analitika/sotuv/spisaniya ko'radi + yetkazib beruvchilarni boshqaradi
  HEAD_CAT_MANAGER // kategoriya menejerlari boshi: BARCHA kategoriyalar bo'yicha menejer ishi + yetkazib beruvchilarni ko'rish
  MARKETING // marketing xodimi — Marketing bo'limini TO'LIQ ko'radi/tahrirlaydi (Promo + Community). Ilgari MERCHANDISER deb atalgan.
  OPERATOR // operator — faqat Hisobdan chiqarish va Sverkani KUZATADI (read-only)
  INVENTORY // inventar xodimi — sotuv hisobot (dashboard) + Inventarizatsiya bo'limi; miniapp'da sanash kiritadi
  LOGIST // logistika nazoratchisi — reyslarni kuzatadi; fors-major holatda haydovchi nomidan tuzatadi
  DRIVER // haydovchi — faqat miniapp: mashina tanlaydi, yo'lga chiqish / yetib borishni belgilaydi
  FINANCE // moliyachi — Moliya bo'limi to'liq + analitika/sotuvni ko'radi (izolyatsiyalanmagan)
}

// Promo (Aksiyalar) turi — har biri odatiy davom etish muddatiga ega
enum PromoType {
  KUN_TAKLIFI // Kun taklifi — 1 kun
  HAFTA_CHEGIRMA // Hafta chegirmasi — 7 kun
  BIZBOP_NARX // Bizbop narx — 1 oy/doimiy (endDate null bo'lishi mumkin)
  AAARZON // A-a-arzon narx! — 14 kun
  FLASH // Flash/bayram aksiyalari
}

// Promo kampaniya holati
enum PromoStatus {
  DRAFT // Qoralama
  ACTIVE // Faol
  ENDED // Tugadi
  CANCELLED // Bekor qilindi
}

// Zakaz (sotib olish buyurtmasi) holati — to'liq workflow:
// menejer yaratadi → tasdiqqa → supplychain tasdiqlaydi → yuboradi →
// yetkazib beruvchi qabul qiladi → yetib keladi (fakt solishtiriladi)
enum OrderStatus {
  DRAFT // Qoralama (menejer)
  PENDING // Tasdiqda (supplychain navbatida)
  APPROVED // Tasdiqlandi (supplychain)
  SENT // Yetkazib beruvchiga yuborildi
  ACCEPTED // Zakaz qabul qilindi (yetkazib beruvchi)
  RECEIVED // Yetib keldi (fakt kiritiladi)
  RETURNED // Qaytarildi
}

enum FileType {
  SALES
  METRICS
  VISITS
}

// PME analyze — SKU'ning ikkinchi o'lchamdagi segmenti (qo'lda biriktiriladi)
enum Segment {
  PREMIUM
  MEDIUM
  EASY
}

// Ombor → filial taqsimot hujjati holati
enum DistributionStatus {
  DRAFT // Qoralama (tahrirlanadi)
  CONFIRMED // Tasdiqlandi (ombor qoldig'idan ayirildi, qulflangan)
  CANCELLED // Bekor qilindi
}

// Filiallararo ko'chirish hujjati holati
enum TransferStatus {
  DRAFT // Qoralama (tahrirlanadi)
  CONFIRMED // Tasdiqlandi (qulflangan — hujjat sifatida)
  CANCELLED // Bekor qilindi
}

enum AliasSource {
  SALES
  VISITS
  SR
  PLANS
}

enum UploadStatus {
  SUCCESS
  FAILED
}

enum PaymentType {
  PERECHISLENIYE
  NAQD
}

enum AnketaFieldType {
  text
  textarea
  number
  yesno
  consent
}

enum SubmissionStatus {
  NEW
  REVIEWED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CAT_MANAGER) // asosiy rol — default kirish sahifasi, JWT
  extraRoles   Role[]   @default([]) // qo'shimcha rollar; ruxsat = role + extraRoles birlashmasi (union)
  telegramId   BigInt?  @unique // Telegram user ID — BizbopSotuv mini app auth (admin/users da biriktiriladi)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploads           UploadedFile[]
  managedCategories CategoryManager[] // kategoriya menejeri javobgar kategoriyalari
  branches          UserBranch[] // biriktirilgan filiallar — bo'sh = barcha filiallar (cheklovsiz)
  purchaseOrders    PurchaseOrder[]
  expenses          Expense[]
  distributions     Distribution[]
  branchTransfers   BranchTransfer[]
  batches           ProductBatch[]
  promoCampaigns    PromoCampaign[] // yaratgan promo aksiyalari (createdBy)
  inventoryItems    InventoryItem[] // inventarizatsiya ro'yxatiga qo'shgan SKU'lari (createdBy)
  inventoryCounts   InventoryCount[] // kiritgan sanashlari (countedBy)
  actedTrips        Trip[] // fors-major holatda haydovchi nomidan kiritgan reyslari
  scorecards        PartnershipScorecard[] // tahrirlagan strategik hamkorlik skorkartalari (updatedBy)
  cashTxns          CashTxn[] // kiritgan kassa yozuvlari (createdBy)
  cashTransfers     CashTransfer[] // kiritgan kassalararo ko'chirishlari
  cashAccounts      UserCashAccount[] // yozuv kirita oladigan hisoblari — bo'sh = cheklovsiz
  cashDayCloses     CashDayClose[] // yopgan kunlari (kassa sanashi)
}

// Foydalanuvchi ↔ filial (ko'p-ko'p): miniapp'da dashboard/inventar shu filiallar bilan
// cheklanadi. Yozuvi yo'q user = barcha filiallarni ko'radi (CEO/admin uchun odatiy).
model UserBranch {
  userId   Int
  branchId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

// Kategoriya menejeri ↔ kategoriya (ko'p-ko'p): bir xodim bir nechta kategoriyaga javobgar.
model CategoryManager {
  userId     Int
  categoryId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Branch {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  chiqimFilial  String? // bizbop (spisaniya bot) yozuvlar.filial nomi — chiqim filtri uchun; null bo'lsa name ishlatiladi. Sozlamalar → Filiallar'da bog'lanadi
  sortOrder     Int      @default(0)
  sverkaTopicId Int? // sverka guruhidagi topic (message_thread_id) — Sozlamalar → Sverka'da
  createdAt     DateTime @default(now())

  aliases           BranchAlias[]
  sales             CategorySales[]
  productSales      ProductSales[]
  metrics           DailyMetrics[]
  receiptMetrics    DailyReceiptMetric[]
  visits            DailyVisits[]
  uploads           UploadedFile[]
  salesPlans        SalesPlan[]
  marginPlans       MarginPlan[]
  writeoffPlans     WriteoffPlan[]
  forecastCurves    ForecastCurve[]
  forecastRuns      ForecastRun[]
  forecastDays      ForecastDay[]
  distributions     Distribution[]
  transfersFrom     BranchTransfer[]          @relation("TransferFrom")
  transfersTo       BranchTransfer[]          @relation("TransferTo")
  batches           ProductBatch[]
  promoCampaigns    PromoCampaign[] // shu filialga oid promo aksiyalar (null = barcha filiallar)
  orderItemBranches PurchaseOrderItemBranch[] // zakaz qatorlarining shu filialga taqsimoti
  supplierProfiles  SupplierBranchProfile[] // yetkazib beruvchilarning shu filial profili
  userBranches      UserBranch[] // shu filialga biriktirilgan foydalanuvchilar (miniapp scope)
  inventoryItems    InventoryItem[] // shu filial uchun belgilangan inventar SKU'lari
  inventoryCounts   InventoryCount[] // shu filialdagi inventarizatsiya sanashlari
  logisticsPoints   LogisticsPoint[] // shu filialga mos reys nuqtasi (odatda bitta)
  tgRequests        TgRequest[] // guruhda shu filial haqida so'ralgan murojaatlar
  skuForecasts      SkuForecast[] // haftalik SKU talab prognozi
  skuForecastAcc    SkuForecastAccuracy[] // prognoz aniqligi baholari
  cashAccounts      CashAccount[] // shu filialning kassa/bank hisoblari (bo'lmasligi ham mumkin)
  costCenters       CostCenter[] // shu filialga mos xarajat markazi
}

model BranchAlias {
  id       Int         @id @default(autoincrement())
  branchId Int
  alias    String
  source   AliasSource

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([alias, source])
  @@index([branchId])
}

model CategoryGroup {
  id        Int    @id @default(autoincrement())
  name      String @unique
  code      Int?   @unique // 1C KOD — bo'lim identifikatori
  sortOrder Int    @default(0)

  categories     Category[]
  forecastCurves ForecastCurve[]
  forecastRuns   ForecastRun[]
}

model Category {
  id        Int    @id @default(autoincrement())
  name      String // 1C'da bir xil nom turli joyda bo'lishi mumkin — farqlash code orqali
  code      Int?   @unique // 1C KOD — kategoriya/subkategoriya identifikatori va matching kaliti
  sortOrder Int    @default(0)
  groupId   Int?
  parentId  Int?

  group    CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parent   Category?      @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]     @relation("CategoryParent")

  aliases           CategoryAlias[]
  sales             CategorySales[]
  products          Product[]
  managers          CategoryManager[]
  salesPlans        SalesPlan[]
  marginPlans       MarginPlan[]
  writeoffPlans     WriteoffPlan[]
  spisaniyaLinks    SpisaniyaCategoryLink[]
  botUserCategories BotUserCategory[]
  tgRequests        TgRequest[] // guruhda shu kategoriyadan so'ralgan murojaatlar
  canonProducts     TgCanonProduct[] // shu subkategoriyadagi kanonik mahsulotlar
  stockdayLimit     StockdayLimit? // maksimal zakaz (zaxira kunlari) chegarasi

  @@index([parentId]) // scope filtrlari (subkat → ota-kategoriya) tezligi uchun
  @@index([groupId])
}

model CategoryAlias {
  id         Int    @id @default(autoincrement())
  categoryId Int
  alias      String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([alias])
  @@index([categoryId])
}

// Sotuv fayllaridan keladigan kategoriya bo'yicha summalar.
// Period 1 kun yoki bir necha kun bo'lishi mumkin (29.04 — bir kun, 1(2).xlsx — 29 kun).
model CategorySales {
  id             Int      @id @default(autoincrement())
  uploadedFileId Int
  branchId       Int
  categoryId     Int
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  amount         Decimal  @db.Decimal(20, 2)
  costAmount     Decimal? @db.Decimal(20, 2)

  uploadedFile UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([branchId, categoryId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([branchId, periodStart, periodEnd])
  @@index([categoryId, periodStart, periodEnd])
  // Davr-overlap so'rovlari uchun periodEnd yetakchi range (ProductSales bilan bir xil sabab).
  @@index([periodEnd, periodStart])
  @@index([uploadedFileId])
}

// sr.xlsx fayllaridan — kunlik chek metrikalari (filial majburiy).
model DailyMetrics {
  id                 Int      @id @default(autoincrement())
  uploadedFileId     Int
  branchId           Int
  date               DateTime @db.Date
  receiptCount       Int
  receiptTotal       Decimal  @db.Decimal(20, 2)
  avgItemsPerReceipt Decimal  @db.Decimal(10, 4)
  avgReceipt         Decimal  @db.Decimal(20, 2)
  bigPurchaseLevel   Decimal  @db.Decimal(20, 2)
  smallPurchaseLevel Decimal  @db.Decimal(20, 2)

  uploadedFile UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
  @@index([branchId, date])
  @@index([uploadedFileId])
}

// export (1).xlsx — kunlik tashriflar (4 filialdan biri har qatorga).
model DailyVisits {
  id             Int      @id @default(autoincrement())
  uploadedFileId Int
  branchId       Int
  date           DateTime @db.Date
  visitCount     Int

  uploadedFile UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
  @@index([branchId, date])
  @@index([uploadedFileId])
}

// Yuklangan har bir fayl audit + dublikat oldini olish uchun saqlanadi.
model UploadedFile {
  id              Int          @id @default(autoincrement())
  label           String // admin tomonidan qo'yilgan nom (chalg'imaslik uchun)
  originalName    String
  fileHash        String       @unique // sha256 — bir xil fayl 2 marta yuklanmaydi
  fileType        FileType
  branchId        Int? // METRICS uchun majburiy, SALES bir filialli bo'lsa shunchaki
  periodStart     DateTime?    @db.Date
  periodEnd       DateTime?    @db.Date
  yearOverride    Int? // VISITS faylda yil bo'lmaganda admin tanlaydi
  templateVersion String? // sotuv shabloni versiyasi (header signaturasidan: v1/v2/v3)
  rowCount        Int          @default(0)
  status          UploadStatus @default(SUCCESS)
  errorMessage    String?
  uploadedById    Int
  createdAt       DateTime     @default(now())

  uploadedBy User    @relation(fields: [uploadedById], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id])

  sales         CategorySales[]
  productSales  ProductSales[]
  metrics       DailyMetrics[]
  visits        DailyVisits[]
  unmatchedRows UnmatchedImportRow[]

  @@index([fileType, periodStart, periodEnd])
  @@index([uploadedById])
}

// Kunlik chek metrikalari — QO'LDA kiritiladi (sr.xlsx emas). Filial × sana.
// Chek soni va chekdagi o'rtacha tovar soni (Tashriflar bo'limi tabida).
model DailyReceiptMetric {
  id              Int      @id @default(autoincrement())
  branchId        Int
  date            DateTime @db.Date
  receiptCount    Int      @default(0) // kunlik chek soni
  itemsPerReceipt Decimal  @default(0) @db.Decimal(10, 3) // chekdagi o'rtacha tovar soni
  createdById     Int? // kim kiritdi (audit)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
}

// ─── Master baza: mahsulot (SKU) darajasidagi ma'lumot ───────────────────────
// Yangi sotuv shabloni (ShablonSotuv.xlsx) mahsulot darajasida keladi.
// Product = 1C mahsulot katalogi; ProductSales = SKU × filial × davr fakt jadval.

model Product {
  id         Int      @id @default(autoincrement())
  code       Int      @unique // 1C mahsulot kodi
  name       String
  categoryId Int? // tegishli kategoriya/subkategoriya (iyerarxiyadagi joyi)
  supplierId Int? // yetkazib beruvchi (POSTAVSHIK)
  agentId    Int? // yetkazib beruvchi ichidagi agent (brend) — SKU shu agentga biriktiriladi
  segment    Segment? // PME analyze segmenti (Premium/Medium/Easy) — qo'lda biriktiriladi
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Joriy holat — har yuklashda denormalizatsiya qilinadi (OOS/zakaz so'rovi
  // ProductSales tarixini skanlamasligi uchun). Manba — eng so'nggi davr.
  currentStock   Decimal?  @db.Decimal(20, 3) // so'nggi davrdagi qoldiq (filiallar yig'indisi)
  currentSold    Decimal?  @db.Decimal(20, 3) // so'nggi davrdagi sotuv (dona)
  abcClass       String?   @db.Char(1) // ABC sinfi (standart 3 oylik oyna) — sotuv yuklashda yangilanadi
  xyzClass       String?   @db.Char(1) // XYZ sinfi (talab barqarorligi) — sotuv yuklashda yangilanadi
  leadTimeDays   Int? // zakazdan kelguncha kunlar — yetkazib beruvchi profilida kiritiladi
  archivedAt     DateTime? // no-aktiv (arxiv) — buyurtma/OOS/Stockday'dan chiqadi, tarix saqlanadi
  packSize       Decimal?  @db.Decimal(20, 3) // pachkadagi dona soni/hajmi (og'irlik/hajm uchun kasr ham) — buyurtmada eslab qolinadi
  purchasePrice  Decimal?  @db.Decimal(20, 2) // kelishilgan sotib olish narxi (dona) — zakazdan eslab qolinadi
  lastSalePeriod DateTime? @db.Date // so'nggi yuklangan davr (eskini bosib o'tmaslik uchun)
  imageData      String?   @db.Text // promo dizayn banner master rasmi — item saqlanganda shu yerga ham yoziladi, yangi aksiyada meros
  imageZoom      Float     @default(1) // master rasm kattalashtirish (x1..x2)

  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier          Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  agent             Agent?                @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sales             ProductSales[]
  nameMismatch      ProductNameMismatch?
  orderItems        PurchaseOrderItem[]
  warehouseStock    WarehouseStock?
  distributionItems DistributionItem[]
  transferItems     BranchTransferItem[]
  batches           ProductBatch[]
  promoItems        PromoItem[] // aksiyalardagi qatnashuvi
  inventoryItems    InventoryItem[] // inventarizatsiya ro'yxatidagi o'rinlari (filial kesimida)
  inventoryCounts   InventoryCount[] // inventarizatsiya sanashlari
  skuForecasts      SkuForecast[] // haftalik talab prognozi (filial kesimida)
  skuForecastAcc    SkuForecastAccuracy[] // prognoz aniqligi baholari

  @@index([categoryId])
  @@index([supplierId])
  @@index([agentId])
  @@index([segment])
}

// Kunlik sotuv faylidagi nom master nomidan farq qilsa — review uchun saqlanadi.
// Admin Moslanmagan → "Nom farqi" tabida: yangilaydi yoki master nomini saqlaydi.
model ProductNameMismatch {
  id             Int      @id @default(autoincrement())
  productId      Int      @unique
  fileName       String // sotuv faylidagi nom
  uploadedFileId Int?
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Yetkazib beruvchi (POSTAVSHIK) — sku.xlsx'dagi yetkazib beruvchi. Mahsulotga 1:N.
model Supplier {
  id            Int     @id @default(autoincrement())
  name          String  @unique // masalan "2-O'RIKZOR BOZOR"
  sortOrder     Int     @default(0)
  // ── Profil ──
  rating        Int? // 1..5 yulduz (menejer bahosi)
  ratingNote    String? // baho izohi
  phone         String?
  contactName   String? // mas'ul shaxs
  // Haftalik takrorlanuvchi zakaz qabul kunlari: 0=Yakshanba ... 6=Shanba (JS getUTCDay)
  orderWeekdays Int[]   @default([])

  // ── Shartlar (SUPPLYCHAIN tahrirlaydi) ──
  paymentType       PaymentType? // ko'chirma | naqd
  ehfMatch          Boolean? // Perechisleniya fakturada (EHF) 1:1 aks etadimi
  otsrochkaDays     Int? // otsrochka (30/45/60/90)
  debitorHas        Boolean? // debitorka limiti bormi
  debitorLimit      Decimal?     @db.Decimal(18, 2) // debitorka limiti summasi
  discountPct       Decimal?     @db.Decimal(6, 2) // asosiy chegirma %
  marketingDiscount Boolean? // marketing skidkasi bormi
  retrobonusPct     Decimal?     @db.Decimal(6, 2) // retrobonus %
  agentMerchNote    String? // agent/merchandiser ishlash tartibi
  promoSystem       String? // promo tizimi izohi
  promoCalendar     Boolean? // promo kalendari tuzilganmi
  // Kontaktlar (ism + tel)
  responsibleRole   String? // Supervayzer/Reg.menejer/Diller/Filial rahbari/Direktor
  responsibleName   String?
  responsiblePhone  String?
  sverkaName        String? // sverka bo'limi
  sverkaPhone       String?
  accountingName    String? // buxgalteriya (EHF mas'uli)
  accountingPhone   String?
  logisticsName     String? // dastavka (logistika)
  logisticsPhone    String?

  products       Product[]
  orders         PurchaseOrder[]
  contracts      SupplierContract[]
  sverkalar      SverkaRecord[]
  orderDays      SupplierOrderDay[]
  agents         Agent[]
  branchProfiles SupplierBranchProfile[] // filial bo'yicha profil ma'lumotlari
  scorecards     PartnershipScorecard[] // strategik hamkorlik skorkartalari (orqa-marja override'lar)
  counterparties Counterparty[] // moliya kontragent reyestridagi mos yozuvlar
}

// Yetkazib beruvchi × filial profil ma'lumotlari (✓ per-filial maydonlar)
model SupplierBranchProfile {
  id              Int      @id @default(autoincrement())
  supplierId      Int
  branchId        Int
  shelfLengthCm   Int? // dolya polka uzunligi (sm)
  faceCount       Int? // face soni
  skuCount        Int? // SKU soni (shu filialda)
  orderDay        String? // zakaz kuni (hafta kuni — ma'lumot)
  deliveryDays    Int? // dastavka necha kun
  deliveryWeekday String? // dastavka qaysi kun
  deliveryTime    String? // dastavka qaysi soat
  dpPaymentTerms  String? // qo'shimcha polka (DP) to'lov sharti
  forecastYearly  Decimal? @db.Decimal(18, 2) // sotuv prognozi (yillik)
  forecastMonthly Decimal? @db.Decimal(18, 2) // sotuv prognozi (oylik)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([supplierId, branchId])
  @@index([branchId])
}

// Agent (BREND) — yetkazib beruvchi ichidagi alohida brend/vakil. Postavshikning
// SKU'lari agentlarga taqsimlanadi; har agent o'z kontakti va zakaz kunlari bilan,
// zakaz har agentga ALOHIDA beriladi (PurchaseOrder.agentId, alohida nakladnoy).
model Agent {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  name          String // brend nomi (yetkazib beruvchi ichida unikal)
  phone         String?
  contactName   String? // mas'ul shaxs
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  // Haftalik takrorlanuvchi zakaz qabul kunlari: 0=Yakshanba ... 6=Shanba (JS getUTCDay)
  orderWeekdays Int[]    @default([])

  supplier   Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  products   Product[]
  orderDays  AgentOrderDay[]
  orders     PurchaseOrder[]
  scorecards PartnershipScorecard[] // brend-darajasidagi skorkarta override'lar

  @@unique([supplierId, name])
  @@index([supplierId])
}

// Strategik hamkorlik skorkartasi (ta'minotchi skorkarti).
// SAQLANADIGAN "yumshoq" orqa-marja override'lari: ta'minotchi × brend × davr kesimida.
// QATTIQ ustunlar (oborot, marja, SKU soni, ulush, ABC) BU YERDA SAQLANMAYDI —
// ular so'rov vaqtida ProductSales'dan hisoblanadi. Bu yerda faqat qo'lda kiritma/override'lar.
// agentId NULL = ta'minotchi-darajasidagi qator; to'ldirilgan = shu brend uchun override.
model PartnershipScorecard {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  agentId     Int? // NULL = supplier-darajasi; to'ldirilgan = brend-darajasi override
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  // ── Yumshoq orqa-marja override'lari (foizlar; NULL = kiritilmagan) ──
  promoCompPct  Decimal? @db.Decimal(6, 2) // Факт Промо компенсации (%)
  rassrochkaPct Decimal? @db.Decimal(6, 2) // Доп. маржа от рассрочки (%)
  bonusPct      Decimal? @db.Decimal(6, 2) // Факт бонусы (%)
  spisaniyePct  Decimal? @db.Decimal(6, 2) // Списание qo'lda override (%, manfiy); NULL = backend vozvratlardan hisoblaydi
  abcOverride   String?  @db.VarChar(4) // ABC qo'lda ("AA" kabi)
  note          String?

  updatedById Int? // oxirgi tahrirlagan foydalanuvchi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  // Har (supplierId, agentId, davr) uchun BITTA yozuv. agentId NULL bo'lgani uchun
  // migration.sql'da unique index'ga NULLS NOT DISTINCT qo'lda qo'shiladi (PG 15+/Neon).
  @@unique([supplierId, agentId, periodStart, periodEnd])
  @@index([supplierId])
  @@index([periodStart, periodEnd])
}

// Yetkazib beruvchi bilan shartnoma — hujjat fayli tashqi havola (Drive va h.k.) sifatida.
model SupplierContract {
  id         Int       @id @default(autoincrement())
  supplierId Int
  title      String // masalan "Yetkazib berish shartnomasi 2026"
  number     String? // shartnoma raqami
  signedAt   DateTime? @db.Date // imzolangan sana
  endDate    DateTime? @db.Date // amal qilish muddati
  amount     Decimal?  @db.Decimal(20, 2) // shartnoma summasi (bo'lsa)
  url        String? // hujjat havolasi (Google Drive va h.k.)
  note       String?
  createdAt  DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// Zakaz — yetkazib beruvchiga sotib olish buyurtmasi (kategoriya menejeri yaratadi).
model PurchaseOrder {
  id          Int         @id @default(autoincrement())
  supplierId  Int
  agentId     Int? // agent (brend) — zakaz har agentga alohida; agentsiz zakazda null
  createdById Int // yaratgan foydalanuvchi (menejer/admin)
  status      OrderStatus @default(DRAFT)
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sentAt      DateTime?
  receivedAt  DateTime?
  rating      Int? // yetib kelgan zakaz bahosi (1..5) — yetkazib beruvchi o'rtachasiga kiradi
  ratingNote  String? // baho izohi (ixtiyoriy)
  ratedAt     DateTime? // baho qo'yilgan vaqt

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  agent     Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([agentId])
  @@index([createdById])
  @@index([status])
}

model PurchaseOrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Decimal  @db.Decimal(20, 3)
  price     Decimal  @db.Decimal(20, 2) // dona narxi
  packCount Decimal? @db.Decimal(20, 3) // nechta blok/yashik buyurtma qilindi (kasr ham bo'lishi mumkin)
  packSize  Decimal? @db.Decimal(20, 3) // o'sha paytdagi pachka soni/hajmi — quantity = packCount × packSize
  factQty   Decimal? @db.Decimal(20, 3) // FAKT yetib kelgan miqdor — solishtirish uchun

  order      PurchaseOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchQtys PurchaseOrderItemBranch[] // filial bo'yicha taqsimot (quantity = yig'indisi)

  @@unique([orderId, productId])
  @@index([productId])
}

// Zakaz qatori × filial — har filialga buyurtma miqdori. PurchaseOrderItem.quantity =
// shu qatorlar yig'indisi (jami). Eski (filialsiz) zakazlarda bu qatorlar bo'lmaydi —
// detal/nakladnoy avtomatik "faqat jami" ko'rinishga tushadi (backward-compatible).
model PurchaseOrderItemBranch {
  id          Int     @id @default(autoincrement())
  orderItemId Int
  branchId    Int
  quantity    Decimal @db.Decimal(20, 3)

  orderItem PurchaseOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, branchId])
  @@index([branchId])
}

// Master sotuv fakti — SKU × filial × davr. Qayta yuklashda upsert (ustiga yoziladi).
model ProductSales {
  id             Int      @id @default(autoincrement())
  uploadedFileId Int
  productId      Int
  branchId       Int
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  stockQty       Decimal? @db.Decimal(20, 3) // Остаток (qoldiq dona)
  soldQty        Decimal? @db.Decimal(20, 3) // Количество (sotilgan dona)
  amount         Decimal  @db.Decimal(20, 2) // Продажи / Сумма (savdo summasi)
  costAmount     Decimal? @db.Decimal(20, 2) // Себестоимость / Сумма (tannarx summasi)
  salePrice      Decimal? @db.Decimal(20, 3) // Продажи / Цена — sotuv narxi (dona, tayyor; faylda bo'lsa)
  costPrice      Decimal? @db.Decimal(20, 3) // Себестоимость / Цена — tannarx narxi (dona, tayyor; faylda bo'lsa)

  uploadedFile UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([branchId, periodStart, periodEnd])
  @@index([productId, periodStart, periodEnd])
  @@index([productId, branchId, periodEnd(sort: Desc)]) // OOS/Stockday "latest snapshot" DISTINCT ON tartibi
  // Davr-overlap (periodStart <= end AND periodEnd >= start): periodEnd yetakchi range —
  // yaqin davr so'rovlarida eski qatorlarni chetlab o'tadi (analytics/marja skanlari).
  @@index([periodEnd, periodStart])
  @@index([uploadedFileId])
}

// Moslanmagan import qatorlari — /api/import/kunlik'dan `kod`siz kelgan (yoki nom
// bo'yicha ham topilmagan) 1C qatorlari yo'qolmasligi uchun xom holda saqlanadi.
// UI "Moslanmagan" bo'limida ko'rsatiladi; keyin qo'lda Product'ga bog'lanishi mumkin.
model UnmatchedImportRow {
  id             Int      @id @default(autoincrement())
  uploadedFileId Int? // UploadedFile'ga FK (ba'zan fayl yozuvi yaratilmaydi)
  day            DateTime @db.Date // JSON'dagi sana
  branchAlias    String // JSON'dagi filial nomi (xom)
  warehouseCode  String? // JSON'dagi skladKod
  name           String // mahsulot nomi (xom)
  artikul        String?
  stockQty       Decimal? @db.Decimal(20, 3) // Остаток (qoldiq dona)
  soldQty        Decimal? @db.Decimal(20, 3) // Количество (sotilgan dona)
  salePrice      Decimal? @db.Decimal(20, 3) // sotuv narxi (dona)
  costPrice      Decimal? @db.Decimal(20, 3) // tannarx narxi (dona)
  amount         Decimal? @db.Decimal(20, 2) // savdo summasi
  costAmount     Decimal? @db.Decimal(20, 2) // tannarx summasi
  createdAt      DateTime @default(now())

  uploadedFile UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)

  @@index([day])
  @@index([uploadedFileId])
}

// Oylik sotuv rejasi — subkategoriya × filial × yil/oy
model SalesPlan {
  id         Int      @id @default(autoincrement())
  branchId   Int
  categoryId Int
  year       Int
  month      Int // 1–12
  amount     Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([branchId, categoryId, year, month])
  @@index([branchId, year, month])
}

// Spisaniya (chiqim) kategoriya ko'prigi — bizbop kategoriya nomi → Iyerarxiya subkat.
// bizbop ALOHIDA bazada (cross-DB join yo'q) — shu sabab nom bo'yicha bog'laymiz.
// yozuvlar.kategoriya (matn) → botName → categoryId → bo'lim/kat/subkat rollup.
model SpisaniyaCategoryLink {
  id         Int      @id @default(autoincrement())
  botName    String   @unique // bizbop kategoriya nomi (yozuvlar.kategoriya bilan mos)
  categoryId Int // Iyerarxiya kategoriya/subkategoriya id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

/// Spisaniya bot xodimiga (bizbop bot_ruxsat.telegram_id) biriktirilgan
/// iyerarxiya kategoriyalari. categoryId OTA kategoriya (parentId=null) bo'lsa —
/// barcha bolalari ham kiradi; SUBkategoriya bo'lsa — faqat o'zi.
/// Xodimda yozuv bo'lmasa = cheklov yo'q (to'liq katalog).
model BotUserCategory {
  telegramId BigInt
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([telegramId, categoryId])
  @@index([categoryId])
}

// Sotuv bo'limi moliyasi — harajatlar (filialsiz, umumiy ro'yxat).
// Summa = miqdor × narx (serverda hisoblanadi).
model Expense {
  id          Int       @id @default(autoincrement())
  name        String // harajat nomi
  quantity    Decimal   @db.Decimal(20, 3) // miqdor
  unitPrice   Decimal   @db.Decimal(20, 2) // narx (bir birlik)
  amount      Decimal   @db.Decimal(20, 2) // summa = quantity × unitPrice
  spentAt     DateTime  @db.Date // harajat qilingan sana
  createdById Int
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? // soft delete — moliyaviy yozuv butunlay o'chmaydi

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([spentAt])
  @@index([spentAt, deletedAt]) // finans sahifasi filtri: spentAt oralig'i + deletedAt IS NULL
  @@index([createdById])
}

// Marja rejasi — subkategoriya × filial (vaqtsiz, o'zgarganda yangilanadi)
model MarginPlan {
  id         Int      @id @default(autoincrement())
  branchId   Int
  categoryId Int
  marginPct  Decimal  @default(0) @db.Decimal(6, 2)
  updatedAt  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([branchId, categoryId])
  @@index([branchId])
  @@index([categoryId])
}

// Chiqim (hisobdan chiqarish) rejasi — subkategoriya × filial, vaqtsiz (MarginPlan naqshi).
// pct = chiqimning SAVDOGA nisbatan ruxsat etilgan ulushi, foizda (masalan 1.250 = 1.25%).
// Kategoriya/bo'lim/umumiy darajadagi reja shu yerdan SAVDO bilan vaznlanib rollup qilinadi
// (src/lib/spisaniya/writeoff-plan.ts). Kompaniya bo'yicha umumiy chegara — AppSetting
// ("writeoff_plan_total_pct"), u rollup bilan yonma-yon nazorat qilinadi.
model WriteoffPlan {
  id         Int      @id @default(autoincrement())
  branchId   Int
  categoryId Int
  pct        Decimal  @default(0) @db.Decimal(6, 3)
  updatedAt  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([branchId, categoryId])
  @@index([branchId])
  @@index([categoryId])
}

// MAKSIMAL ZAKAZ nazorati: kategoriya bo'yicha ruxsat etilgan eng katta zaxira kunlari.
// Zakazga miqdor kiritilganda natijaviy stockday hisoblanadi —
//   (qoldiq + zakaz miqdori) / kunlik o'rtacha sotuv
// — va shu chegaradan oshsa qator ogohlantiriladi (bloklanmaydi: mavsum/aksiya uchun
// ataylab ko'p olinishi mumkin, lekin tasdiqlash so'raladi).
//
// Kompaniya bo'yicha UMUMIY standart — AppSetting ("zakaz_max_stockday"); shu jadval
// faqat ISTISNOLARni saqlaydi (go'sht 10 kun, konserva 90 kun kabi). Eng aniq qoida
// ustun: subkategoriya → kategoriya → global. WriteoffPlan naqshi bilan bir xil —
// `categoryId` NOT NULL, global qiymat AppSetting'da (Postgres'da NULL bilan unique
// indeks `NULLS NOT DISTINCT` talab qilardi, u lokal PG14 da yo'q).
model StockdayLimit {
  id         Int      @id @default(autoincrement())
  categoryId Int // kategoriya YOKI subkategoriya (iyerarxiyaning istalgan darajasi)
  maxDays    Int // ruxsat etilgan eng katta zaxira kunlari
  note       String?  @db.VarChar(120) // nega shunday (masalan "muddati qisqa")
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId])
}

// AI prognoz egri chizig'i — filial × bo'lim × oy uchun kunlik og'irlik (taqsimot shakli).
// Og'irliklar oy bo'yicha yig'indisi = 1. Kunlik prognoz = bo'lim oylik rejasi × weight.
// Shu sabab kunlik prognoz yig'indisi har doim aniq rejaga teng bo'ladi.
model ForecastCurve {
  id       Int      @id @default(autoincrement())
  branchId Int
  groupId  Int
  year     Int
  month    Int // 1–12
  date     DateTime @db.Date
  weight   Decimal  @db.Decimal(9, 8)

  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group  CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([branchId, groupId, year, month, date])
  @@index([branchId, year, month])
  @@index([date])
}

// Kunlik prognoz summasi — filial × oy × kun (barcha bo'limlar yig'indisi).
// Dashboard va Rejalar "Kunlik prognoz" tab shu jadvalni o'qiydi/tahrirlaydi.
// locked=true — admin qo'lda o'zgartirgan kun; qayta taqsimlashda o'zgarmaydi.
// Yig'indi (oy bo'yicha) = filial oylik reja summasiga teng (tahrirda saqlanadi).
model ForecastDay {
  id       Int      @id @default(autoincrement())
  branchId Int
  year     Int
  month    Int
  date     DateTime @db.Date
  amount   Decimal  @db.Decimal(18, 2)
  locked   Boolean  @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year, month, date])
  @@index([date])
  @@index([branchId, year, month])
}

// Prognoz yaratish jurnali — filial × bo'lim × oy uchun AI izohi va meta.
model ForecastRun {
  id        Int      @id @default(autoincrement())
  branchId  Int
  groupId   Int
  year      Int
  month     Int
  model     String // ishlatilgan model (yoki "fallback")
  rationale String // AI ning qisqa izohi (nega shunday taqsimladi)
  createdAt DateTime @default(now())

  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group  CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([branchId, groupId, year, month])
  @@index([branchId, year, month])
}

// ─── SKU TALAB PROGNOZI (haftalik) ───────────────────────────────────────────────────
// DIQQAT: yuqoridagi ForecastCurve/ForecastDay/ForecastRun — BOSHQA narsa (filial
// oylik REJAsini kunlarga taqsimlash). Bu blok esa SKU×filial talabini haftalik
// prognozlaydi va o'z aniqligini o'lchab boradi.
//
// Faza 1 o'lchovi (rolling origin, 3 oyna, 1.3 mln katak) qurilishni belgilagan:
//   • Faqat 4 HAFTALIK JAMI validatsiya qilingan (h=1 da FVA ≈ 0, 8/12 hafta uchun
//     tarix yetmaydi) — shuning uchun `horizon` saqlanadi va UI'da ochiq yoziladi.
//   • `baseline` (ayni oynadagi naive1) QATORDA saqlanadi: FVA maxraji keyin qayta
//     hisoblanmaydi, aks holda "modelni qulay, baseline'ni noqulay o'lchash"
//     soxtalashtirishi mumkin bo'lardi.
//   • Faqat yig'indilar saqlanadi (WAPE/BIAS/FVA o'qishda hisoblanadi) — nisbatlarni
//     saqlab keyin o'rtachalash ikki xil raqam beradi.

model SkuForecastRun {
  id          Int       @id @default(autoincrement())
  weekStart   DateTime  @db.Date // ORIGIN: train'ga kirgan oxirgi TO'LIQ hafta (dushanba)
  horizon     Int // prognoz gorizonti, hafta (validatsiyalangan: 4)
  modelKey    String    @db.VarChar(24) // siyosat nomi ("gate-v1"), qatordagi model emas
  z           Float // MEROS: eski formulaning z'i (q90 endi empirik kvantil bilan)
  // Kalibratsiya — o'sha yugurishda AYNAN qaysi koeffitsient ishlatilgani. Bu qatorlar
  // bo'lmasa "nega o'tgan haftada boshqa raqam chiqqan" degan savolga javob yo'q.
  biasK       Float     @default(1) // global BIAS koeffitsienti (prognoz shunga BO'LINADI)
  servis      Float     @default(0.9) // maqsad servis darajasi (q90 kvantili)
  panelWeeks  Int // panelda mavjud to'liq haftalar
  seriesTotal Int // paneldagi faol seriyalar (SKU×filial)
  forecasted  Int // prognoz yozilgan seriyalar
  skippedKam  Int       @default(0) // "KAM" sinf — tarix yetarli emas, model qurilmaydi
  skippedArch Int       @default(0) // arxivlangan SKU
  scoredRows  Int       @default(0) // shu run keyinchalik necha seriyada baholandi
  scoredAt    DateTime? // fakt kelib, aniqlik o'lchangan payt (null — hali pishmagan)
  status      String    @default("ok") @db.VarChar(8) // ok | error
  note        String?   @db.VarChar(300)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  forecasts SkuForecast[]
  accuracy  SkuForecastAccuracy[]
  segments  SkuForecastSegment[]
  calib     SkuForecastCalib[]

  @@unique([weekStart, horizon, modelKey]) // bir hafta × bir siyosat = bitta run (idempotent)
  @@index([scoredAt])
}

model SkuForecast {
  id         Int      @id @default(autoincrement())
  runId      Int
  productId  Int
  branchId   Int
  sinf       String   @db.VarChar(12) // SMOOTH | ERRATIC | INTERMITTENT | LUMPY
  modelKey   String   @db.VarChar(16) // AYNAN shu qatorda ishlatilgan model (sinf gate'i)
  p50        Float // gorizont JAMISI, dona
  q90        Float // servis darajasi (z kalibrlanmaguncha taxminiy)
  baseline   Float // ayni oynadagi naive1 — FVA maxraji
  zeroProb   Float? // gorizont ichida nol bo'lish ehtimoli (LUMPY/INTERMITTENT uchun)
  lastQty    Float // oxirgi to'liq hafta fakti ("o'tgan hafta" ustuni)
  trainWeeks Int
  nz         Int // nolmas haftalar soni
  adi        Float?
  cv2        Float?
  unitPrice  Float // dona narxi — so'mli og'irlik
  targetFrom DateTime @db.Date // birinchi prognoz haftasi (dushanba)
  targetTo   DateTime @db.Date // OXIRGI prognoz haftasi (dushanba, inklyuziv)

  run     SkuForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([runId, productId, branchId])
  @@index([productId, branchId])
  @@index([targetTo])
}

// Fakt kelgandan keyingi baho — bitta seriya × bitta oyna. Faqat yig'indilar.
model SkuForecastAccuracy {
  id           Int      @id @default(autoincrement())
  runId        Int // BAHOLANGAN run (prognoz qilingan origin)
  productId    Int
  branchId     Int
  sinf         String   @db.VarChar(12)
  modelKey     String   @db.VarChar(16)
  actual       Float // oyna JAMISI (fakt)
  forecast     Float
  baseline     Float
  absErr       Float
  sqErr        Float
  baseAbsErr   Float
  baseSqErr    Float
  amountWeight Float // fakt × dona narxi (so'mli og'irlik)
  posWeeks     Int // oyna ichida fakt > 0 bo'lgan haftalar
  // q90 SHU YERDA HAM saqlanadi: prognoz detali 12 haftada tozalanadi, aniqlik esa
  // 26 hafta yashaydi — aks holda servis darajasi tarixi detal bilan birga yo'qolardi.
  q90          Float    @default(0)
  // Gorizont ichida qoldiq tugagan: sotuv 0 bo'lgani talab yo'qligini BILDIRMAYDI.
  // Qator baribir saqlanadi (audit uchun), lekin metrikadan CHIQARILADI.
  stockout     Boolean  @default(false)
  targetTo     DateTime @db.Date
  scoredAt     DateTime @default(now())

  run     SkuForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([runId, productId, branchId])
  @@index([productId, branchId, targetTo]) // seriyaning oxirgi N oynasi (ishonch belgisi)
  @@index([targetTo])
}

// Kesim agregati — "Prognoz sifati" sahifasi shu jadvalni o'qiydi (detal tozalangandan
// keyin ham tarix qoladi). scope+key: ALL/*, SINF/SMOOTH, BRANCH/3, KAT/12, ABC/A.
model SkuForecastSegment {
  id           Int     @id @default(autoincrement())
  runId        Int
  horizon      Int
  scope        String  @db.VarChar(12)
  key          String  @db.VarChar(48)
  label        String? @db.VarChar(160) // ko'rsatish uchun nom (filial/kategoriya)
  seriya       Int
  n            Int
  posWeeks     Int
  actual       Float
  forecast     Float
  absErr       Float
  sqErr        Float
  baseAbsErr   Float
  baseSqErr    Float
  amountWeight Float
  ishonchli    Int     @default(0) // WAPE ≤ 30% (oxirgi 4 oyna)
  taxminiy     Int     @default(0) // 30–60%
  ishonchsiz   Int     @default(0) // > 60%
  // SERVIS iqtisodi: qoplash = qopladi / n. `ortiqcha` va `kamomad` — DONA:
  // Σmax(0, q90 − fakt) va Σmax(0, fakt − q90). Faqat qoplashni ko'rsatish yetarli
  // emas — 90% qoplashga har qanday narxda erishish mumkin, savol NARXIDA.
  qopladi      Int     @default(0)
  ortiqcha     Float   @default(0)
  kamomad      Float   @default(0)

  run SkuForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, horizon, scope, key])
  @@index([scope, key])
}

// Yugurishda ishlatilgan kalibratsiya (sinf kesimida) — provenance. Koeffitsient
// tarixdan o'rganiladi, ya'ni har hafta o'zgaradi; qaysi raqam qachon ishlatilgani
// saqlanmasa, o'tgan haftaning prognozini qayta tushuntirib bo'lmaydi.
model SkuForecastCalib {
  id     Int     @id @default(autoincrement())
  runId  Int
  // Kalibratsiya kaliti. Hozirgi sxema: "<ABC>|<p50 bandi>" (masalan "A|300-1k"),
  // zaxira daraja — faqat band ("300-1k"). Kalit ATAYLAB erkin matn: kesim sxemasi
  // o'lchov natijasiga qarab o'zgarib turadi (sinf → sinf×abc → abc×band), har
  // safar migratsiya yozish esa provenance jadvali uchun ortiqcha.
  kalit  String  @db.VarChar(32)
  quantC Float // √-masshtab kvantil koeffitsienti: q90 = p50 + c·√(p50+1)
  n      Int // necha baho qatoridan o'rganildi (0 — sovuq start qiymati)
  sovuq  Boolean @default(false) // tarix yo'q edi, o'lchangan default ishlatildi

  run SkuForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, kalit])
}

// ─── Yetkazib beruvchi anketasi (supplier.oilagroup.uz) ──────────────────────────────
// Forma maydonlari sozlanuvchan — Tizim → Anketa bo'limida tahrirlanadi.
// Bo'lim (section) alohida entity — bo'sh bo'lim bo'lishi, nomi tahrirlanishi mumkin.
model AnketaSection {
  id        Int           @id @default(autoincrement())
  title     String // bo'lim sarlavhasi (KOMPANIYA HAQIDA UMUMIY MA'LUMOT ...)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  fields    AnketaField[]
}

model AnketaField {
  id        Int             @id @default(autoincrement())
  sectionId Int
  section   AnketaSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  type      AnketaFieldType @default(text)
  required  Boolean         @default(false)
  sortOrder Int             @default(0) // bo'lim ichidagi tartib
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@index([sectionId, sortOrder])
}

// Yuborilgan anketalar — javoblar JSON ({ fieldId: qiymat })
model AnketaSubmission {
  id          Int              @id @default(autoincrement())
  companyName String // tezkor ro'yxat uchun (Kompaniya nomi javobidan)
  phone       String?
  answers     Json
  status      SubmissionStatus @default(NEW)
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
}

// ─── Sverka — yetkazib beruvchi bilan solishtirish yozuvi (Telegram Mini App) ──
// Kiritish tartibi: sana → firma (Supplier'dan tanlanadi) → sklad → kontragent →
// dagavor → summa + nakladnoy rasmi (Telegram file_id, rasm-yukla sxemasi).
model SverkaRecord {
  id         Int      @id @default(autoincrement())
  sana       DateTime @db.Date
  supplierId Int? // firma — yetkazib beruvchilar bazasidan (o'chsa NULL, nom qoladi)
  firmaNomi  String // tanlash paytidagi nom (snapshot)
  sklad      String
  qabulQildi String // tovarni qabul qilgan xodim (Sozlamalar → Sverka ro'yxatidan)
  dagavor    String
  summa      Decimal  @db.Decimal(20, 2)
  rasmFileId String // nakladnoy rasmi — Telegram file_id
  tgUserId   BigInt // kim kiritdi (Telegram ID)
  tgUserName String?
  createdAt  DateTime @default(now())

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([sana])
  @@index([supplierId])
  @@index([createdAt])
}

// Sverka botiga ruxsat berilgan xodimlar (alohida bot, alohida ro'yxat —
// ERP Sverka sahifasida SA/SUPPLYCHAIN boshqaradi).
model SverkaXodim {
  id        Int      @id @default(autoincrement())
  tgUserId  BigInt   @unique
  ism       String?
  createdAt DateTime @default(now())
}

// Umumiy kalit-qiymat sozlamalar (asosiy baza) — masalan SVERKA_GROUP_CHAT_ID
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Zakaz qabul kunlari — ANIQ SANALAR (kalendardan bittalab belgilanadi).
// orderWeekdays (haftalik takror) o'rnini bosdi; eski ustun meros sifatida qoladi.
model SupplierOrderDay {
  id         Int      @id @default(autoincrement())
  supplierId Int
  sana       DateTime @db.Date

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, sana])
  @@index([sana])
}

// Markaziy ombor qoldig'i — kunlik import (kod → qoldiq) bilan yangilanadi (1C sotuv
// faylida yo'q). Bitta markaziy ombor; snapshot (oxirgi import). Taqsimot shu asosda.
model WarehouseStock {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  qty       Decimal  @default(0) @db.Decimal(20, 3)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Ombor → filial taqsimot hujjati (tizim yaratadi). Tasdiqlanganda ombor qoldig'idan ayiriladi.
model Distribution {
  id          Int                @id @default(autoincrement())
  branchId    Int // qabul qiluvchi filial
  status      DistributionStatus @default(DRAFT)
  targetDays  Int                @default(7) // qoplash kunlari (tavsiya uchun)
  note        String?
  createdById Int
  createdAt   DateTime           @default(now())
  confirmedAt DateTime?

  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     DistributionItem[]

  @@index([branchId])
  @@index([status])
}

model DistributionItem {
  id             Int     @id @default(autoincrement())
  distributionId Int
  productId      Int
  qty            Decimal @db.Decimal(20, 3) // taqsimlanadigan miqdor

  distribution Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([distributionId, productId])
  @@index([productId])
}

// Filiallararo ko'chirish hujjati — manba filialdagi ortiqcha/o'lik qoldiqni qabul
// qiluvchi filialga ko'chirish (shoshilinch OOS uchun, markaziy ombordan o'tmasdan).
// Filial qoldig'i kunlik importdan keladi (o'zgaruvchan jadval yo'q) — tasdiqlash
// faqat hujjatni qulflaydi, qoldiq ayirilmaydi (import qayta yangilaydi).
model BranchTransfer {
  id           Int            @id @default(autoincrement())
  fromBranchId Int // manba (ortiqcha/o'lik qoldiqli)
  toBranchId   Int // qabul qiluvchi (kam/OOS)
  status       TransferStatus @default(DRAFT)
  targetDays   Int            @default(7) // qoplash kunlari (tavsiya uchun)
  note         String?
  createdById  Int
  createdAt    DateTime       @default(now())
  confirmedAt  DateTime?

  fromBranch Branch               @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch   Branch               @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items      BranchTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
}

model BranchTransferItem {
  id         Int     @id @default(autoincrement())
  transferId Int
  productId  Int
  qty        Decimal @db.Decimal(20, 3) // ko'chiriladigan miqdor

  transfer BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
  @@index([productId])
}

// Mahsulot partiyasi (lot) — yaroqlilik MUDDATI nazorati uchun. Qo'lda yoki fayl import
// bilan kiritiladi. branchId null = markaziy ombor. Markdown (chegirma) xavfi: qoldiq vs
// muddatgacha sotiladigan miqdor (kunlik o'rtacha × qolgan kun). Bir joyda bir muddat = bitta
// partiya (productId + branchId + expiryDate unikal — COALESCE indeks migratsiyada).
model ProductBatch {
  id          Int      @id @default(autoincrement())
  productId   Int
  branchId    Int? // null = markaziy ombor
  qty         Decimal  @db.Decimal(20, 3) // partiyadagi qoldiq
  expiryDate  DateTime @db.Date // yaroqlilik muddati (tugash sanasi)
  note        String?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([branchId])
  @@index([expiryDate])
}

// Agent (brend) zakaz qabul kunlari — SupplierOrderDay'ga parallel, lekin agent darajasida.
model AgentOrderDay {
  id      Int      @id @default(autoincrement())
  agentId Int
  sana    DateTime @db.Date

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, sana])
  @@index([sana])
}

// Sverka "Qabul qildi" ro'yxati — qabul qiluvchi xodim ismlari
// (Sozlamalar → Sverka'da yuritiladi, mini app'da tanlanadi).
model SverkaQabulchi {
  id        Int      @id @default(autoincrement())
  ism       String   @unique
  createdAt DateTime @default(now())
}

// Promo (Aksiya) kampaniyasi — bir turdagi, sanali aksiya.
// branchId null bo'lsa BARCHA filiallarga tegishli, aks holda bitta filialga.
model PromoCampaign {
  id          Int         @id @default(autoincrement())
  type        PromoType
  title       String
  status      PromoStatus @default(DRAFT)
  startDate   DateTime    @db.Date
  endDate     DateTime?   @db.Date // null = BIZBOP_NARX doimiy
  branchId    Int? // null = barcha filiallar
  note        String?
  createdById Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch     Branch?          @relation(fields: [branchId], references: [id])
  createdBy  User             @relation(fields: [createdById], references: [id])
  items      PromoItem[]
  itemGroups PromoItemGroup[]

  @@index([type, status])
  @@index([startDate, endDate])
  @@index([branchId])
  @@index([createdById])
}

// Aksiya ICHIDAGI SKU guruhi — bir mahsulotning har xil ta'm/turlari (mas. "Sochnaya
// Dolina Sok 1L" → Abrikos, Persik, …). Faqat shu kampaniyaga tegishli (qayta ishlatilmaydi).
// Guruh o'chsa SKU'lar guruhsiz bo'lib qoladi (PromoItem.groupId → SetNull).
model PromoItemGroup {
  id            Int      @id @default(autoincrement())
  campaignId    Int
  name          String
  sortOrder     Int      @default(0)
  designTitle   String? // dizayn banner uchun chiroyli nom (uz); null = guruh nomi fallback
  designTitleRu String? // ixtiyoriy ru qator (null = ko'rsatilmaydi)
  imageData     String?  @db.Text // oq/shaffof fonli mahsulot rasmi — "data:image/png;base64,..."
  imageZoom     Float    @default(1) // dizayn banner rasm yaqinlashtirish (x1..x2, kasr ham: 1.3/1.7)
  limitUnit     String   @default("dona") // banner limitining birligi: dona/ta/kg
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaign PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items    PromoItem[]

  @@index([campaignId])
}

// Promo kampaniyasidagi alohida tovar — narxlar dona uchun.
model PromoItem {
  id            Int      @id @default(autoincrement())
  campaignId    Int
  productId     Int
  groupId       Int? // aksiya ichidagi SKU guruhi (ixtiyoriy; null = guruhsiz)
  regularPrice  Decimal  @db.Decimal(20, 2) // sotilish (oddiy) narxi
  promoPrice    Decimal  @db.Decimal(20, 2) // aksiya narxi (N+M mexanikada = regularPrice — dona narxi o'zgarmaydi)
  promoLimit    Decimal? @db.Decimal(20, 3) // aksiya limiti (dona, kasr ham bo'lishi mumkin)
  // N+M ("N dona ol, M dona tekin": 1+1, 2+1, 3+2...) mexanikasi — ikkisi ham to'lsa faol,
  // ikkisi ham null = oddiy narx-chegirma. Effektiv chegirma = freeQty/(buyQty+freeQty) (hosila).
  buyQty        Int? // N — to'liq narxda olinadigan dona
  freeQty       Int? // M — tekin beriladigan dona
  priceReturned Boolean? // aksiya tugagach narx asliga qaytdimi (hisobot to'ldiradi)
  designTitle   String? // dizayn banner uchun chiroyli nom (uz; guruhsiz SKU uchun) — null = Product.name fallback
  designTitleRu String? // ixtiyoriy ru qator (null = ko'rsatilmaydi)
  imageData     String?  @db.Text // oq/shaffof fonli mahsulot rasmi — "data:image/png;base64,..."
  imageZoom     Float    @default(1) // dizayn banner rasm yaqinlashtirish (x1..x2, kasr ham: 1.3/1.7)
  limitUnit     String   @default("dona") // banner limitining birligi: dona/ta/kg
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaign PromoCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  group    PromoItemGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([campaignId, productId])
  @@index([productId])
  @@index([campaignId])
  @@index([groupId])
}

// ─── Inventarizatsiya ─────────────────────────────────────────────────────────
// Belgilangan SKU'lar ro'yxati — HAR FILIAL uchun alohida (SKU × filial). ERP'ning
// /inventarizatsiya bo'limida SA/CEO tuzadi; miniapp (BizbopSotuv) xodimning filialida
// faqat o'sha filialga belgilangan SKU'larni sanashga chiqaradi.
model InventoryItem {
  id          Int      @id @default(autoincrement())
  productId   Int
  branchId    Int
  createdById Int
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([productId, branchId])
  @@index([branchId])
}

// Inventarizatsiya sanashi — (SKU × filial × kun) bitta yozuv (qayta kiritilsa upsert).
// systemQty — kiritish paytidagi tizim qoldig'i (snapshot; keyin tizim o'zgarsa ham
// hisobot o'sha paytdagi farqni ko'rsatadi). Farq = countedQty - systemQty.
model InventoryCount {
  id          Int      @id @default(autoincrement())
  productId   Int
  branchId    Int
  sanaKuni    DateTime @db.Date // sanash kuni (Toshkent)
  systemQty   Decimal  @db.Decimal(20, 3)
  countedQty  Decimal  @db.Decimal(20, 3)
  note        String? // izoh (masalan kamomad sababi)
  countedById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  countedBy User    @relation(fields: [countedById], references: [id], onDelete: Restrict)

  @@unique([productId, branchId, sanaKuni])
  @@index([branchId, sanaKuni])
  @@index([sanaKuni])
}

// Cron ishlarining kunlik bajarilishi — dedup (replika/deploy'da ikki marta yubormaslik)
// + catch-up (server o'chib qolib o'tkazib yuborilgan ishni startda bir marta bajarish).
model CronRun {
  id     Int      @id @default(autoincrement())
  job    String // ish nomi (masalan "inv-report")
  dayKey String // "YYYY-MM-DD" (Toshkent)
  status String   @default("ok") // ok | error
  ranAt  DateTime @default(now())
  note   String?

  @@unique([job, dayKey])
}

// ─── LOGISTIKA: REYSLAR (ma'lumotnoma) ────────────────────────────────────────
// Reys nuqtalari va avtopark. Reys hujjatining o'zi (Trip/TripLeg) alohida
// migratsiyada qo'shiladi — bu qism avval to'ldiriladi (ma'lumotnomasiz reys
// ochib bo'lmaydi: nuqta ham, avto ham ro'yxatdan tanlanadi, erkin matn YO'Q).

enum PointKind {
  WAREHOUSE // markaziy sklad / RC — reyslar shu yerdan boshlanadi
  BRANCH // savdo filiali — Branch'ga ulanadi
  CITY // boshqa shahar (Samarqand, Buxoro, Navoiy...)
  OTHER // bozor, dala hovli, qurilish obyekti, avtostansiya...
}

/// Reys nuqtasi. Branch'dan kengroq: RC, bozor, boshqa shahar ham nuqta bo'ladi,
/// lekin savdo filiali bo'lsa Branch KANONIK qoladi va shunga ulanadi (parallel
/// filial ro'yxati yaratilmaydi).
model LogisticsPoint {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  kind      PointKind @default(OTHER)
  branchId  Int? // savdo filiali bo'lsa — Branch bilan bog'lanadi
  isHub     Boolean   @default(false) // RC / markaziy sklad — bu yerga yetib kelish reysni yopadi
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)

  // Geofence (miniapp LocationManager, Bot API 8.0) — "yo'lga chiqdim"/"yetib bordim"
  // bosilgan paytdagi koordinata shu nuqtaga solishtiriladi. Bloklamaydi, faqat
  // nazoratchi taxtasida belgi qo'yadi. Null = tekshiruv o'tkazilmaydi.
  lat Decimal? @db.Decimal(9, 6)
  lng Decimal? @db.Decimal(9, 6)

  // Uzoq yo'nalish (Samarqand/Toshkent/Buxoro) — qulfni avtomatik bo'shatish
  // ostonasi shu nuqta uchun uzaytiriladi, aks holda tungi reys yolg'on STALE bo'ladi.
  isLongHaul Boolean @default(false)
  staleHours Int? // null = global ostona

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  legsFrom  TripLeg[]  @relation("LegFrom")
  legsTo    TripLeg[]  @relation("LegTo")
  ratesFrom TripRate[] @relation("RateFrom")
  ratesTo   TripRate[] @relation("RateTo")

  @@index([isActive, sortOrder])
  @@index([branchId])
}

/// Avtomobil profili. Sig'im bitta joyda turadi — qo'lda yuritishda bitta avto
/// uch xil m3 bilan yozilgan edi. Hujjat muddatlari tugasa ish TO'XTAMAYDI:
/// haydovchiga ogohlantirish ko'rsatiladi, nazoratchiga signal ketadi.
model Vehicle {
  id                  Int       @id @default(autoincrement())
  plateNumber         String    @unique
  brand               String // Лабо, Дамас, Исузу
  model               String?
  capacityM3          Decimal?  @db.Decimal(6, 2)
  capacityVagonetka   Decimal?  @db.Decimal(6, 2) // yuklama shu birlikda o'lchanadi
  insuranceUntil      DateTime? @db.Date // sug'urta amal qilish muddati
  techInspectionUntil DateTime? @db.Date // texnik ko'rik muddati
  isActive            Boolean   @default(true)
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  trips Trip[]

  @@index([isActive])
}

// ─── LOGISTIKA: REYS HUJJATI ──────────────────────────────────────────────────
// Reys = bitta chiqish-qaytish sikli (RC → Filial → Filial → RC). Reyslar ko'p
// to'xtashli bo'lgani uchun yassi jadval yaramaydi: Trip (bosh) + TripLeg (plecho).
//
// REJA USTUNI YO'Q — faqat FAKT yoziladi. Vaqtni haydovchi miniappda tugma bosib
// belgilaydi; fors-major holatda nazoratchi haydovchi nomidan kiritadi (kim, kim
// nomidan va nima sababdan — hammasi yoziladi).

enum TripStatus {
  OPEN // yo'lda — mashina QULFLANGAN
  DONE // yakunlandi (odatda hub'ga qaytish bilan)
  DONE_LATE // haydovchi kech bo'lsa ham HAQIQIY faktni keltirdi (STALE'dan keyin)
  FORCE_CLOSED // qo'lda yopilgan (haydovchi yoki nazoratchi)
  STALE // ostona o'tdi, tizim qulfni bo'shatdi — arrivedAt NULL QOLADI
  CANCELLED
}

/// Yuk to'ldirilganligi — miniappda chip'ning O'ZI jo'natish tugmasi (bosish
/// soni oshmaydi). EMPTY alohida: bo'sh yurish eng qimmat ko'rsatkich.
enum LoadLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTER
  FULL
}

enum ActorKind {
  DRIVER // haydovchi o'zi (odatiy)
  CONTROLLER // nazoratchi haydovchi nomidan (fors-major)
  SYSTEM // cron
}

/// Haydovchi. ATAYLAB User EMAS: User'da email+passwordHash majburiy va haydovchi
/// ERP'ga umuman kirmaydi — 10 ta soxta akkaunt admin ro'yxatini ifloslantirardi.
/// SverkaXodim bilan bir xil naqsh. Role.DRIVER enum qiymati bazada bor, lekin
/// ISHLATILMAYDI (Postgres enum qiymatini o'chirib bo'lmaydi).
model Driver {
  id        Int      @id @default(autoincrement())
  name      String
  tgUserId  BigInt   @unique // miniapp shu orqali taniydi (initData.user.id)
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips Trip[]

  @@index([isActive])
}

/// Reys — bosh hujjat.
///
/// ⚠️ DIQQAT — QULF INVARIANTI: bu jadvalda uchta PARTIAL UNIQUE INDEX bor va ular
/// migratsiyaga QO'LDA yozilgan (Prisma DSL partial index'ni ifodalay olmaydi):
///   Trip_open_per_vehicle_uniq  — bitta avtoda bir vaqtda bitta ochiq reys
///   Trip_open_per_driver_uniq   — bitta haydovchi bir vaqtda bitta mashinada
///   TripLeg_open_per_trip_uniq  — reys ichida bitta ochiq plecho
/// Keyingi `prisma migrate dev` ularni "ortiqcha" deb DROP qilishi mumkin —
/// migratsiya SQL'ini har safar tekshiring. instrumentation.ts da boot-assert bor.
model Trip {
  id     Int        @id @default(autoincrement())
  status TripStatus @default(OPEN)

  vehicleId Int
  driverId  Int

  startedAt DateTime  @default(now()) // SERVER vaqti — yagona haqiqat
  endedAt   DateTime?
  endReason String?

  // Telegram guruh xabari — har reysga BITTA xabar, keyin editMessageText bilan
  // yangilanadi (aks holda kuniga ~88 bildirishnoma = spam).
  tgChatId    String?
  tgMessageId Int?

  // Kim kiritdi. actorName — SNAPSHOT (User o'chsa ham tarix o'qiladi).
  actorKind           ActorKind @default(DRIVER)
  actorUserId         Int?
  actorName           String
  impersonationReason String? // actorKind != DRIVER bo'lsa MAJBURIY (server tekshiradi)

  payAmount Decimal? @db.Decimal(12, 2) // reysbay haq — TripRate'dan hisoblanadi

  clientEventId String   @unique // idempotentlik: takroriy bosish/qayta yuborish
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  legs      TripLeg[]

  @@index([status])
  @@index([driverId, startedAt])
  @@index([vehicleId, startedAt])
  @@index([startedAt])
}

/// Plecho — ikki to'xtash orasidagi bo'lak.
///
/// departedAt va arrivedAt ALOHIDA yoziladi (birlashtirilmaydi): shunda nuqtada
/// turib qolish vaqti = departedAt(N+1) − arrivedAt(N) real o'lchanadi. Rejasiz
/// tizimda kechikishni bilvosita ko'rsatuvchi yagona metrika shu.
model TripLeg {
  id     Int @id @default(autoincrement())
  tripId Int
  seq    Int // 1, 2, 3... reys ichidagi tartib

  fromPointId Int
  toPointId   Int

  // Jo'nash. departedAt — SERVER vaqti (tahlilda faqat u ishlatiladi),
  // clientDepartedAt — qurilma da'vosi (farq katta bo'lsa xabarga qator qo'shiladi).
  departedAt       DateTime  @default(now())
  clientDepartedAt DateTime?
  departLat        Decimal?  @db.Decimal(9, 6)
  departLng        Decimal?  @db.Decimal(9, 6)

  // Yetib borish. NULL = plecho ochiq (yo'lda).
  arrivedAt       DateTime?
  clientArrivedAt DateTime?
  arriveLat       Decimal?  @db.Decimal(9, 6)
  arriveLng       Decimal?  @db.Decimal(9, 6)

  /// STALE'dan keyin kelgan haqiqiy fakt. Qulfni bo'shatish faktni YO'Q QILMAYDI:
  /// haydovchi kech bo'lsa ham haqiqatni keltirsa — qabul qilinadi va shu bayroq
  /// qo'yiladi (tahlilda istaganda chiqarib tashlanadi, lekin ma'lumot saqlanadi).
  lateReport Boolean @default(false)

  load          LoadLevel
  loadEstimated Boolean   @default(false) // true = nazoratchi taxmin qildi, haydovchi emas

  arrivedActorKind   ActorKind?
  arrivedActorUserId Int?

  note          String?
  clientEventId String  @unique

  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromPoint LogisticsPoint @relation("LegFrom", fields: [fromPointId], references: [id], onDelete: Restrict)
  toPoint   LogisticsPoint @relation("LegTo", fields: [toPointId], references: [id], onDelete: Restrict)

  @@unique([tripId, seq])
  @@index([tripId, seq])
  @@index([arrivedAt])
  @@index([departedAt])
}

/// Reysbay haq tarifi (from→to juftligi uchun summa).
/// Adoptsiyaning yagona kuchli richagi: haq aynan shu yozuvlardan hisoblansa,
/// haydovchi tizimga O'ZI uchun yozadi. Tarif o'zgarsa yangi qator qo'shiladi —
/// eski reyslarning hisobi retroaktiv o'zgarmasin.
model TripRate {
  id          Int      @id @default(autoincrement())
  fromPointId Int
  toPointId   Int
  amount      Decimal  @db.Decimal(12, 2)
  km          Decimal? @db.Decimal(6, 2)
  activeFrom  DateTime @db.Date
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  fromPoint LogisticsPoint @relation("RateFrom", fields: [fromPointId], references: [id], onDelete: Cascade)
  toPoint   LogisticsPoint @relation("RateTo", fields: [toPointId], references: [id], onDelete: Cascade)

  @@unique([fromPointId, toPointId, activeFrom])
  @@index([isActive])
}

// ─── TIZIM: KIRISHLAR JURNALI (platforma + botlar) ───────────────────────────
// Faqat SYSTEM_ADMIN ko'radi (/admin/kirishlar). Ikki jadval ATAYLAB ajratilgan:
//
//   AccessEvent   — autentifikatsiya MOMENTI (kirdi / kira olmadi / rad etildi).
//                   Kam, lekin qimmatli yozuv; xavfsizlik paneli shundan quriladi.
//   AccessSession — FAOLLIK OYNASI (30 daqiqa jimlikdan keyin yangisi ochiladi).
//                   Botlar miniappda HAR harakatda API chaqiradi — har chaqiruvni
//                   hodisa deb yozsak kuniga o'n minglab qator bo'lardi. Shu sababli
//                   sessiya qatori bir marta ochiladi, keyin `lastSeenAt`/`hits`
//                   yangilanib boradi (yozish qatlami buferlaydi: src/lib/access-log).
//
// Davomiylik DENORMAL ustunda saqlanmaydi — `lastSeenAt - startedAt` bo'yicha
// hisobda derivatsiya qilinadi (bitta haqiqat manbai).
//
// Sana kesimi `dayKey` (Toshkent "YYYY-MM-DD", CronRun.dayKey naqshi): SQL'da TZ
// konversiyasi va ifodali indeks kerak emas — `migrate dev` ifodali indeksni
// "ortiqcha" deb DROP qilib yuborardi.
//
// FK ATAYLAB YO'Q: (a) bot foydalanuvchilarining `User` yozuvi umuman bo'lmasligi
// mumkin (Driver / SverkaXodim / bizbop whitelist), (b) audit yozuvi foydalanuvchi
// o'chirilishini bloklamasin va u bilan birga YO'QOLMASIN. Kim ekani `actorName`
// snapshotida qoladi.

/// Kirish nuqtasi — har biri alohida auth yo'liga mos keladi.
enum AccessSurface {
  WEB // platforma (NextAuth Credentials) — src/auth.ts authorize()
  BOT_KIRISH // umumiy Telegram darvozasi /api/ruxsat — qaysi bot ekani hali noma'lum
  BOT_SPISANIYA // /api/yozuv, /api/vozvrat, /api/sku — bizbop whitelist (ruxsatBormi)
  BOT_SVERKA // /api/sverka/* — SverkaXodim
  BOT_LOGISTIKA // /api/logistika/* — Driver (authDriver)
  BOT_SOTUV // /api/miniapp-sotuv/* — User.telegramId
}

/// Hodisa turi. DENIED va LOGIN_FAIL ATAYLAB ajratilgan: birinchisi "shaxs
/// tasdiqlandi, lekin ro'yxatda yo'q" (whitelist), ikkinchisi "parol/imzo
/// yaroqsiz" — ya'ni hujum belgisi bo'lishi mumkin.
enum AccessEventType {
  LOGIN_OK // muvaffaqiyatli kirish (yangi sessiya ochildi)
  LOGIN_FAIL // parol xato / initData imzosi yaroqsiz / forma yaroqsiz
  DENIED // autentifikatsiya OK, lekin ruxsat yo'q (whitelist/nofaol)
  BLOCKED // rate-limit to'sdi (juda ko'p urinish)
}

/// Bitta kirish hodisasi. APPEND-ONLY; `access-cleanup` cron 1 yildan eskisini o'chiradi.
model AccessEvent {
  id        Int             @id @default(autoincrement())
  surface   AccessSurface
  type      AccessEventType
  dayKey    String          @db.VarChar(10) // Toshkent kuni "YYYY-MM-DD" — todayTashkentISO()
  userId    Int? // platforma foydalanuvchisi (FK yo'q — yuqoridagi izoh)
  tgUserId  BigInt? // Telegram ID (Driver / SverkaXodim / whitelist / User.telegramId)
  actorName String?         @db.VarChar(120) // SNAPSHOT — keyin o'zgarsa ham tarix o'zgarmaydi
  login     String?         @db.VarChar(120) // WEB: kiritilgan login satri. PAROL HECH QACHON YOZILMAYDI
  reason    String?         @db.VarChar(40) // BAD_INPUT | NO_USER | BAD_PASSWORD | BAD_SIGNATURE | NOT_WHITELISTED | RATE_LIMIT
  route     String?         @db.VarChar(120) // "/api/logistika/holat"
  createdAt DateTime        @default(now())

  @@index([dayKey]) // davr bo'yicha barcha so'rovlarning yetakchi ustuni
  @@index([createdAt(sort: Desc)]) // "so'nggi hodisalar" lentasi
  @@index([surface, dayKey]) // yuza × kun agregati
  @@index([type, createdAt(sort: Desc)]) // xavfsizlik paneli (FAIL/DENIED/BLOCKED)
  @@index([userId, createdAt(sort: Desc)]) // bitta xodim tarixi
  @@index([tgUserId, createdAt(sort: Desc)]) // bitta bot foydalanuvchisi tarixi
}

/// Faollik oynasi: aktorning uzluksiz ishlash seansi. 30 daqiqa jimlikdan keyingi
/// birinchi so'rov YANGI qator ochadi. `hits` — oynadagi so'rovlar soni.
model AccessSession {
  id      Int           @id @default(autoincrement())
  surface AccessSurface

  /// Aktor kaliti: "u:12" (User.id) yoki "tg:518123456". ATAYLAB matn va NOT NULL —
  /// userId/tgUserId nullable bo'lgani uchun ular bo'yicha unique kalit
  /// `NULLS NOT DISTINCT` talab qilardi (PG15+ da bor, lokal PG14 da yo'q).
  actorKey   String   @db.VarChar(40)
  dayKey     String   @db.VarChar(10) // startedAt ning Toshkent kuni
  userId     Int?
  tgUserId   BigInt?
  actorName  String?  @db.VarChar(120)
  hits       Int      @default(1) // sessiya davomidagi so'rovlar soni
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // davomiylik = lastSeenAt - startedAt

  @@index([dayKey])
  @@index([actorKey, surface, lastSeenAt(sort: Desc)]) // "ochiq sessiya bormi?" — jarayon restartidan keyingi sovuq yo'l
  @@index([surface, dayKey]) // yuza × kun agregati
  @@index([lastSeenAt(sort: Desc)]) // "hozir faol" lentasi
  @@index([userId, startedAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Mijozlar guruhi (Telegram) — so'rov/murojaat analitikasi
// ─────────────────────────────────────────────────────────────────────────────

/// Kuzatiladigan Telegram guruh. chatId — Bot API formatida (supergroup: -100…).
model TgGroup {
  id       Int      @id @default(autoincrement())
  chatId   BigInt   @unique
  title    String?  @db.VarChar(200)
  active   Boolean  @default(true)
  joinedAt DateTime @default(now())

  messages TgGroupMessage[]
}

/// Guruhdagi xom xabar arxivi. Jonli webhook ham, Telegram Desktop JSON eksporti
/// ham SHU jadvalga yozadi (`source` bilan farqlanadi) — statistika bitta manbadan.
model TgGroupMessage {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  messageId Int // Telegram message_id (chat ichida unikal)
  threadId  Int? // topic / message_thread_id — guruh topic'larga bo'lingan bo'lsa
  sentAt    DateTime // xabar yuborilgan payt (Telegram date, UTC)
  dayKey    String   @db.VarChar(10) // sentAt ning Toshkent kuni — kunlik agregat uchun

  fromId   BigInt? // yuboruvchi Telegram ID
  fromName String? @db.VarChar(120) // SNAPSHOT — keyin ism o'zgarsa ham tarix o'zgarmaydi
  fromBot  Boolean @default(false)

  text      String    @db.Text // matn (caption ham shu yerga); media-only bo'lsa bo'sh
  mediaKind String?   @db.VarChar(20) // photo | video | document | voice | sticker …
  replyToId Int? // reply qilingan message_id (javob zanjirini tiklash uchun)
  editedAt  DateTime?

  source    String   @db.VarChar(8) // LIVE | EXPORT
  createdAt DateTime @default(now())

  group    TgGroup     @relation(fields: [chatId], references: [chatId], onDelete: Cascade)
  requests TgRequest[] // shu xabardan AI ajratgan so'rovlar

  @@unique([chatId, messageId]) // qayta import / dublikat update idempotent bo'lsin
  @@index([chatId, sentAt])
  @@index([chatId, dayKey])
  @@index([chatId, replyToId]) // "shu xabarga javoblar" — zanjir yig'ish
  @@index([fromId])
}

/// AI tahlil OYNASI — bir kunning deterministik bo'lagi (50 ta CORE xabar).
/// Qayta tahlil kerak-kerakmasligini `inputHash` + `promptVersion` + `model` hal qiladi:
/// uchtasi ham o'zgarmagan bo'lsa Gemini CHAQIRILMAYDI (pul va vaqt tejaladi).
/// Oyna chegarasi QAT'IY 50 talik — jimlik bo'yicha surilmaydi, aks holda EXPORT
/// backfill bitta eski xabar qo'shsa butun kunning chegaralari siljirdi.
model TgAnalysisWindow {
  id             Int      @id @default(autoincrement())
  chatId         BigInt
  dayKey         String   @db.VarChar(10) // Toshkent kuni — TgGroupMessage.dayKey bilan bir xil
  seq            Int // kun ichidagi tartib: 0,1,2…
  firstMessageId Int // CORE boshi — chegara auditi uchun
  lastMessageId  Int // CORE oxiri
  msgCount       Int // CORE'dagi xabarlar soni
  inputHash      String   @db.Char(64) // sha256(messageId|editedAt|matn …) — matn o'zgarsa qayta tahlil
  promptVersion  Int // PROMPT_VERSION konstantasi — promptni o'zgartirsangiz oshiring
  model          String   @db.VarChar(48) // qaysi model bilan olingani (statistika siljishini ko'rish uchun)
  status         String   @db.VarChar(10) // PENDING | OK | ERROR
  error          String?  @db.VarChar(300) // redactError'dan o'tgan matn
  inTokens       Int?
  outTokens      Int?
  analyzedAt     DateTime @default(now())

  requests TgRequest[]

  @@unique([chatId, dayKey, seq])
  @@index([chatId, dayKey])
  @@index([status]) // qayta urinish kerak bo'lgan oynalarni topish
}

/// MIJOZ MUROJAATI — AI ajratgan bitta so'rov. Bitta xabarda bir nechta bo'lishi
/// mumkin ("tarvuz va uzum bormi") — shuning uchun `itemIndex`.
model TgRequest {
  id        Int      @id @default(autoincrement())
  windowId  Int
  chatId    BigInt
  messageId Int // TgGroupMessage.messageId — mijoz savoli
  itemIndex Int      @default(0)
  dayKey    String   @db.VarChar(10) // denormalizatsiya: kunlik hisobot JOIN'siz ishlasin
  askedAt   DateTime

  kind        String  @db.VarChar(12) // PRODUCT | PRICE | PROMO | COMPLAINT | RETURN | SERVICE | OTHER
  status      String  @db.VarChar(12) // YES | NO | UNANSWERED | UNCLEAR
  answerScope String? @db.VarChar(12) // SAME | OTHER_BRANCH | LINK | UNKNOWN
  lang        String  @db.VarChar(3) // UZ | RU | MIX
  asksPrice   Boolean @default(false)
  asksPhoto   Boolean @default(false)

  productText String?  @db.VarChar(120) // mijoz yozganidek (xom) — audit uchun
  productNorm String?  @db.VarChar(120) // katalog tilida (ruscha-translit, BOSH HARF) — ASOSIY agregatsiya kaliti
  searchTerms String[] // trigram qidiruv variantlari (uz / kirill / translit)
  brand       String?  @db.VarChar(60)

  branchId    Int? // SERVER aniqlaydi (BranchAlias orqali), AI emas
  normKey     String? @db.VarChar(120) // canonKey(productNorm) — SQL'dan guruhlash/updateMany uchun
  canonId     Int? // KANONIK mahsulot — hisobot AYNAN shu bo'yicha yig'iladi
  categoryId  Int? // subkategoriya — kanon topilmasa ham to'ldiriladi (assortiment bo'shlig'i uchun HAL QILUVCHI)
  matchStatus String  @default("PENDING") @db.VarChar(10) // PENDING | AUTO | AI | MANUAL | NONE
  matchScore  Float?

  priceQuoted   Decimal?  @db.Decimal(14, 2) // javobda aytilgan narx (server matndan tasdiqlaydi)
  priceUnit     String?   @db.VarChar(4) // KG | DONA
  firstAnswerAt DateTime?
  answerMinutes Int? // SERVER hisoblaydi — AI ga daqiqa sanatilmaydi
  answerIds     Int[] // javob xabarlari ID'lari (audit va UI'da ko'rsatish)
  dupOfId       Int? // 30 daq. ichida shu mijozning ayni so'rovi takrori — statistikadan chiqadi
  confidence    Float
  note          String?   @db.VarChar(160) // faqat UNCLEAR bo'lsa sabab
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  window   TgAnalysisWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  message  TgGroupMessage   @relation(fields: [chatId, messageId], references: [chatId, messageId], onDelete: Cascade)
  canon    TgCanonProduct?  @relation(fields: [canonId], references: [id], onDelete: SetNull)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([chatId, messageId, itemIndex]) // dublikatning FIZIK to'sig'i
  @@index([chatId, dayKey, kind])
  @@index([dayKey, status])
  @@index([categoryId, dayKey]) // "qaysi kategoriyadan ko'p so'ralyapti"
  @@index([canonId, dayKey]) // "ko'p so'ralgan, lekin YO'Q" TOP ro'yxati
  @@index([normKey]) // qo'lda tuzatishni BARCHA bir xil yozuvlarga qo'llash
  @@index([matchStatus]) // qo'lda hal qilinadiganlar navbati
}

/// KANONIK MAHSULOT — reyestr. "Shaftoli", "шафтоли", "Persik", "Персик", "saftoli"
/// hammasi SHU yozuvga yig'iladi. Hisobot AYNAN `TgRequest.canonId` bo'yicha agregatsiya
/// qilinadi. SKU (Product) ga BOG'LIQ EMAS — operator "yo'q" degan mahsulot katalogda ham
/// yo'q bo'ladi, shuning uchun reyestr MIJOZ TILIDAN quriladi.
model TgCanonProduct {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(80) // ko'rinadigan nom: o'zbek lotin, faqat 1-harf katta
  nameKey  String @unique @db.VarChar(80) // canonKey(name) — DUBLIKATGA QARSHI YAGONA FIZIK KAFOLAT
  fuzzyKey String @db.VarChar(80) // fuzzyKey(name) — dublikat sweep va nomzod izlash; UNIKAL EMAS

  categoryId Int? // subkategoriya — AI beradi, admin tuzatadi
  synonyms   String[] // ["Persik","Персик","шафтоли"] — sovuq startda nomzod topishga
  hits       Int      @default(0) // shu kanonga bog'langan so'rovlar — top-K promptga solish uchun

  source     String    @default("AI") @db.VarChar(6) // AI | MANUAL
  reviewedAt DateTime? // admin ko'rib chiqqan; null = "yangi kanonlar" navbatida

  /// ≠null → kanon BIRLASHTIRILGAN (tombstone). HECH QACHON o'chirilmaydi:
  /// `nameKey` band qolishi shart, aks holda o'sha nom qaytadan yaratiladi.
  mergedIntoId Int?
  mergedAt     DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mergedInto TgCanonProduct?  @relation("CanonMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom TgCanonProduct[] @relation("CanonMerge")
  aliases    TgProductAlias[]
  requests   TgRequest[]

  @@index([categoryId])
  @@index([fuzzyKey])
  @@index([mergedIntoId])
  @@index([hits(sort: Desc)])
  @@index([reviewedAt])
}

/// VARIANT → KANON ko'prigi. Bir marta yechilgan yozilish shakli keyingi safar
/// LLM'ga BORMAYDI.
model TgProductAlias {
  id        Int      @id @default(autoincrement())
  normKey   String   @unique @db.VarChar(120) // canonKey(productNorm) — LOOKUP KALITI
  fuzzyKey  String   @db.VarChar(120)
  raw       String   @db.VarChar(120) // AI bergan productNorm (audit)
  canonId   Int
  source    String   @db.VarChar(6) // EXACT | FUZZY | AI | MANUAL
  score     Float?
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canon TgCanonProduct @relation(fields: [canonId], references: [id], onDelete: Cascade)

  @@index([canonId])
  @@index([fuzzyKey])
}

/// Kanon birlashtirish JURNALI — merge qaytarib bo'lmaydigan amal.
model TgCanonMerge {
  id            Int      @id @default(autoincrement())
  sourceId      Int
  targetId      Int
  sourceName    String   @db.VarChar(80) // SNAPSHOT — keyin nom o'zgarsa ham tarix o'zgarmaydi
  targetName    String   @db.VarChar(80)
  movedAliases  Int
  movedRequests Int
  userId        Int?
  createdAt     DateTime @default(now())

  @@index([targetId])
  @@index([createdAt(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════════════
// MOLIYA — naqd/pul oqimi (DDS, treasury). To'liq reja: MOLIYA_PLAN.md
//
// Asosiy prinsiplar:
//  • Qoldiq HECH QACHON saqlanmaydi — CashAccountOpening + CashTxn'dan hisoblanadi.
//  • Har transfer (Инкасса/Переброс/Обмен) = 1 CashTransfer + 2 CashTxn (double-entry).
//    Bir tomonlama yozuv bo'lishi mumkin emas — kiritishda qarshi hisob majburiy.
//  • Neytral moddalar (isNeutral) hech qanday daromad/xarajat KPI'siga kirmaydi.
//  • occurredAt (aniq vaqt) kun ichidagi tartibni saqlaydi; businessDate (Asia/Tashkent
//    kuni) hisobot va kunlik yopish uchun — src/lib/date.ts (isoDay) bilan hisoblanadi.
// ═══════════════════════════════════════════════════════════════════════════════

enum CashAccountKind {
  CASH // naqd kassa
  BANK // bank hisobvarag'i — inkassatsiya shu yerga tushadi
  CARD // plastik / ekvayring
}

/// DDS ning klassik uch bo'limi + texnik. TECHNICAL = pul kompaniya ichida ko'chdi.
enum CashFlowSection {
  OPERATING // savdo tushumi, ta'minotchi, ish haqi, kommunal, logistika
  INVESTING // Зарафшон/Навоий Малл qurilishi, ер, transport sotib olish
  FINANCING // moliyaviy yordam, dividend, qarz, kredit, ustav fondi
  TECHNICAL // inkassa, obmen, perebros, ochilish qoldig'i, kassa farqi
}

enum CashDirection {
  IN
  OUT
}

/// Modda qaysi yo'nalishda ishlatilishi MUMKIN — kiritishda validatsiya uchun.
/// Manbadagi xato: "Камомад" chiqimi "Савдо тушуми" (kirim) moddasiga yozilgan.
enum CashArticleDirection {
  IN_ONLY
  OUT_ONLY
  BOTH
}

enum CostCenterKind {
  BRANCH // savdo nuqtasi
  PROJECT // alohida biznes/loyiha: Зарафшон Малл, Навоий Малл, Молхона
  COMPANY // umumkorporativ (Ofis)
}

enum CounterpartyKind {
  EMPLOYEE // xodim
  SUPPLIER // ta'minotchi (Supplier bilan bog'lanadi)
  ACCOUNTABLE // hisobdor shaxs (podotchyot) — ochiq qoldig'i kuzatiladi
  OTHER
}

enum CashTxnSource {
  MANUAL // web forma
  MINIAPP // telefon (Telegram mini app)
  IMPORT // Google Sheets'dan ko'chirilgan tarix — qulflangan
}

/// Xarajat KIMGA tegishli. Hisob = pul QAYSI kassadan chiqqani — bu ikki xil narsa.
/// Dalil: "04.03 · Маззона kassasi · Кунликчи 2 та · Зарафшон Малл курилиш".
model CostCenter {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  kind      CostCenterKind
  branchId  Int? // BRANCH bo'lsa — mavjud filialga bog'lanadi
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  branch   Branch?       @relation(fields: [branchId], references: [id])
  accounts CashAccount[]
  txns     CashTxn[]

  @@index([branchId])
  @@index([kind])
}

/// Kassa / bank hisobi / plastik. Filialga bog'lanishi IXTIYORIY — har filialda
/// kassa bo'lishi shart emas (loyiha egasining qarori).
model CashAccount {
  id           Int             @id @default(autoincrement())
  name         String          @unique
  kind         CashAccountKind @default(CASH)
  branchId     Int?
  costCenterId Int? // odatiy xarajat markazi (kiritishda oldindan to'ldiriladi)
  currency     String          @default("UZS")
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  /// Shu sanadan boshlab qoldiq ISHONCHLI (fizik sanash bilan tasdiqlangan).
  /// Undan oldingi davr hisobotda "tarixiy — tasdiqlanmagan" bayrog'i bilan chiqadi:
  /// meros ishonchsizligi (Офис −30.2 mlrd) o'chirilmaydi, IZOLYATSIYA qilinadi.
  trustedFrom  DateTime?       @db.Date
  createdAt    DateTime        @default(now())

  branch     Branch?     @relation(fields: [branchId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  aliases      CashAccountAlias[]
  txns         CashTxn[]
  openings     CashAccountOpening[]
  transfersOut CashTransfer[]       @relation("CashTransferFrom")
  transfersIn  CashTransfer[]       @relation("CashTransferTo")
  closes       CashDayClose[]
  users        UserCashAccount[]

  @@index([branchId])
  @@index([costCenterId])
}

/// Tarix importi uchun manbadagi imlo variantlari ("Смарт", "SMART Market").
model CashAccountAlias {
  id        Int    @id @default(autoincrement())
  accountId Int
  alias     String @unique

  account CashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Modda ierarxiyasining 2-darajasi: guruh (bo'lim ichida).
model CashFlowGroup {
  id        Int             @id @default(autoincrement())
  code      String          @unique // "OP_PAYROLL", "TECH_TRANSFER"
  name      String // "Xodim xarajatlari"
  section   CashFlowSection
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)

  articles CashFlowArticle[]

  @@index([section])
}

/// 3-daraja: modda ("Статья ДДС"). Manbada ~68 ta noyob.
/// O'CHIRILMAYDI — faqat isActive=false (tarixiy yozuvlar buzilmasin).
model CashFlowArticle {
  id         Int                  @id @default(autoincrement())
  code       String               @unique // "OP_SALES_MEGA", "TECH_INKASSA"
  name       String               @unique // manbadagi kanonik nom: "Иш хаки харажатлари"
  groupId    Int
  direction  CashArticleDirection @default(BOTH)
  /// ENG MUHIM MAYDON. true = pul kompaniya ichida ko'chdi yoki texnik yozuv;
  /// hech qanday daromad/xarajat KPI'siga KIRMAYDI. Namunada shunday moddalar
  /// jami chiqimning 50.8% ini tashkil qilgan (faqat Инкасса — 42.5%).
  /// DIQQAT: isNeutral ≠ section=TECHNICAL. Дивидент/Молиявий ёрдам — FINANCING,
  /// lekin isNeutral=false (real pul kirdi/chiqdi, faqat operatsion emas).
  isNeutral  Boolean              @default(false)
  /// true = bu modda har doim CashTransfer'ning bir tomoni (Инкасса/Переброс/Обмен).
  /// Kiritishda qarshi hisob MAJBURIY bo'ladi.
  isTransfer Boolean              @default(false)
  isActive   Boolean              @default(true)
  sortOrder  Int                  @default(0)
  note       String?

  group   CashFlowGroup          @relation(fields: [groupId], references: [id])
  aliases CashFlowArticleAlias[]
  txns    CashTxn[]

  @@index([groupId])
}

/// info varag'idagi qisqa nom → kanonik modda lug'ati
/// (Ойлик→Иш хаки, Камунал→Электр энергияси, Салярка→Ёнилги...).
model CashFlowArticleAlias {
  id        Int    @id @default(autoincrement())
  articleId Int
  alias     String @unique

  article CashFlowArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// Kim pul oldi/berdi. Manbada bu erkin matn edi va 3-4 xil imloda yozilardi
/// ("Исматов Элёр" / "Исамтов Элёр", "Азимов Акбар" / "Акбар ака").
/// Endi reyestrdan TANLANADI — erkin matn emas.
model Counterparty {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  kind       CounterpartyKind @default(OTHER)
  supplierId Int? // SUPPLIER bo'lsa — mavjud Supplier bilan ko'prik
  phone      String?
  note       String?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  aliases  CounterpartyAlias[]
  txns     CashTxn[]

  @@index([supplierId])
  @@index([kind])
}

model CounterpartyAlias {
  id             Int    @id @default(autoincrement())
  counterpartyId Int
  alias          String @unique

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([counterpartyId])
}

/// Bitta pul harakati. "Қолдиқ" ustuni YO'Q — qoldiq doim hisoblanadi.
model CashTxn {
  id             Int           @id @default(autoincrement())
  occurredAt     DateTime // aniq vaqt — kun ichidagi tartib
  businessDate   DateTime      @db.Date // Asia/Tashkent kuni — hisobot/yopish uchun
  accountId      Int
  articleId      Int
  direction      CashDirection
  amount         Decimal       @db.Decimal(20, 2)
  counterpartyId Int?
  costCenterId   Int?
  note           String?
  transferId     Int? // to'ldirilgan bo'lsa — bu transferning bir tomoni
  source         CashTxnSource @default(MANUAL)
  isLocked       Boolean       @default(false) // ko'chirilgan tarix — tahrirlanmaydi
  sourceRowHash  String?       @unique // import idempotentligi (takroriy yuklash xavfsiz)
  createdById    Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account      CashAccount     @relation(fields: [accountId], references: [id])
  article      CashFlowArticle @relation(fields: [articleId], references: [id])
  counterparty Counterparty?   @relation(fields: [counterpartyId], references: [id])
  costCenter   CostCenter?     @relation(fields: [costCenterId], references: [id])
  transfer     CashTransfer?   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id])

  @@index([businessDate])
  @@index([accountId, businessDate])
  @@index([articleId, businessDate])
  @@index([counterpartyId])
  @@index([costCenterId])
  @@index([transferId])
}

/// Kassalararo ko'chirish (Инкасса → BANK, Переброс, Обмен).
/// Har biri AYNAN 2 ta CashTxn yaratadi — yetim yozuv bo'lishi mumkin emas.
model CashTransfer {
  id            Int      @id @default(autoincrement())
  fromAccountId Int
  toAccountId   Int
  amount        Decimal  @db.Decimal(20, 2)
  occurredAt    DateTime
  businessDate  DateTime @db.Date
  note          String?
  createdById   Int?
  createdAt     DateTime @default(now())

  fromAccount CashAccount @relation("CashTransferFrom", fields: [fromAccountId], references: [id])
  toAccount   CashAccount @relation("CashTransferTo", fields: [toAccountId], references: [id])
  createdBy   User?       @relation(fields: [createdById], references: [id])
  txns        CashTxn[]

  @@index([businessDate])
  @@index([fromAccountId])
  @@index([toAccountId])
}

/// Davr boshi qoldig'i — fizik sanash yoki tarix importidan ("Остатка" moddasi).
model CashAccountOpening {
  id        Int      @id @default(autoincrement())
  accountId Int
  onDate    DateTime @db.Date
  amount    Decimal  @db.Decimal(20, 2)
  note      String?
  createdAt DateTime @default(now())

  account CashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, onDate])
}

/// Foydalanuvchi qaysi hisoblarga yozuv kirita oladi (2–5 kishi kiritadi).
/// Bo'sh = cheklovsiz (UserBranch naqshi).
model UserCashAccount {
  userId    Int
  accountId Int

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account CashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// INTEGRATSIYA — tashqi tizim (1C) PUSH qiladigan hodisalar.
//
// PRINSIP: avval XOM saqlanadi, keyin qayta ishlanadi.
// 1C konfiguratsiyalari har xil va sxema kelishuv jarayonida o'zgaradi. Agar biz
// qabul paytida parse qilib, tushunmaganini rad etsak — ma'lumot YO'QOLADI va
// 1C tomonda qayta yuborish mexanizmi bo'lmasligi mumkin. Shuning uchun endpoint
// payload'ni o'zgartirmasdan yozadi va 200 qaytaradi; biznes mantiq alohida
// bosqichda (status PENDING → PROCESSED) ishlaydi.
// ═══════════════════════════════════════════════════════════════════════════════

enum IntegrationSource {
  ONEC // 1C
}

enum IntegrationEventStatus {
  PENDING // qabul qilindi, hali qayta ishlanmagan
  PROCESSED // biznes modelga yozildi
  FAILED // qayta ishlashda xato — attempts oshadi, qayta urinish mumkin
  SKIPPED // ataylab e'tiborsiz qoldirildi (kerak bo'lmagan hujjat turi)
}

model IntegrationEvent {
  id          Int                    @id @default(autoincrement())
  source      IntegrationSource      @default(ONEC)
  /// 1C obyekt turi — kelgan holicha ("ЧекККМ", "ПоступлениеТоваровУслуг",
  /// "ПеремещениеТоваров", "СписаниеТоваров"...). Ro'yxat oldindan qotirilmaydi:
  /// yangi tur kelsa ham qabul qilinadi va bu yerda ko'rinadi.
  kind        String
  /// 1C `Ref_Key` (GUID) — hujjatning barqaror identifikatori.
  externalId  String?
  /// Hujjat raqami (`Номер`) — odam o'qiydigan ko'rinish uchun.
  externalNo  String?
  /// Hujjat sanasi (`Дата`) — 1C bergan. Qabul vaqti bilan adashtirmaslik uchun alohida.
  occurredAt  DateTime?
  /// Xom JSON — o'zgartirilmasdan saqlanadi.
  payload     Json
  /// sha256(payload) — takroriy yuborish DUBL YARATMAYDI (1C retry qilsa xavfsiz).
  payloadHash String                 @unique
  status      IntegrationEventStatus @default(PENDING)
  /// Qayta ishlash xatosi (foydalanuvchiga ko'rsatiladi, sir tozalangan holda).
  error       String?
  attempts    Int                    @default(0)
  /// Bitta so'rovda kelgan guruh — nosozlikni izlashda butun partiyani ko'rish uchun.
  batchId     String?
  receivedAt  DateTime               @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@index([kind, occurredAt])
  @@index([externalId])
  @@index([batchId])
}

/// Kunlik yopish — fizik sanash natijasi va kunni QULFLASH.
/// Yopilgan kunga yangi yozuv kiritib/o'chirib bo'lmaydi: aks holda kechagi
/// sanash bugun "noto'g'ri" bo'lib qolardi va farq qayerdan chiqqani yo'qolardi.
model CashDayClose {
  id         Int      @id @default(autoincrement())
  accountId  Int
  onDate     DateTime @db.Date
  /// Yopish paytida tizim hisoblagan qoldiq.
  expected   Decimal  @db.Decimal(20, 2)
  /// Mas'ul fizik sanagan naqd.
  counted    Decimal  @db.Decimal(20, 2)
  /// counted − expected. Manfiy = kamomad, musbat = ortiqcha.
  /// Manbada bu "Касса фарк" moddasiga QO'LDA yozilardi; endi avtomatik hisoblanadi.
  diff       Decimal  @db.Decimal(20, 2)
  note       String?
  closedById Int?
  closedAt   DateTime @default(now())

  account  CashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  closedBy User?       @relation(fields: [closedById], references: [id])

  @@unique([accountId, onDate])
  @@index([onDate])
}
